# ============================================================
# MANI 272 STORE — Environment Variables Example
# ============================================================
# Copy this file to ".env.local" and fill in your values.
# Never commit .env.local to git.

# ---- FamPay UPI & Automated Payment Verification (Gmail IMAP) ----
# Your FamPay UPI ID (e.g. mani272@fam)
NEXT_PUBLIC_FAMPAY_UPI_ID=mani272@fam
FAMPAY_UPI_ID=mani272@fam

# The Gmail address where FamPay sends transaction confirmation emails ("no-reply@famapp.in")
GMAIL_USER=yourgmail@gmail.com

# 16-character Google App Password (Generated from: Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Secret token to protect the external cron endpoint (/api/verify)
CRON_SECRET=your_long_random_secret_token_here

# Discord Webhook URL for real-time sales & payment notifications
DISCORD_SALES_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# ---- MongoDB Database (Optional for Production Persistence) ----
# MongoDB connection URI (e.g. MongoDB Atlas). If not provided, system uses local json fallback.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mani272store?retryWrites=true&w=majority

# ---- Supabase (Optional) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- App Config ----
NEXT_PUBLIC_APP_NAME=MANI 272 STORE
NEXT_PUBLIC_ADMIN_EMAILS=admin@mani272store.com

# ---- Discord ----
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/4DMtsmZX6k
NEXT_PUBLIC_DISCORD_SERVER_NAME=MANI 272 STORE
NEXT_PUBLIC_DISCORD_SERVER_DESCRIPTION=Join our community for support, updates and exclusive offers.

# ---- YouTube ----
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_YOUTUBE_CHANNEL_NAME=MANI 272
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@eagle272-v4p

# ---- Site URL ----
NEXT_PUBLIC_SITE_URL=https://mani-272-store.vercel.app
