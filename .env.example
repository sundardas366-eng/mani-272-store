# ============================================================
# MANI 272 STORE — Environment Variables Example
# ============================================================
# Copy this file to ".env.local" and fill in your values.
# Never commit .env.local to git.

# ---- FamPay UPI & Direct UPI Payment Config ----
# Your FamPay UPI ID (Receives customer UPI payments)
NEXT_PUBLIC_FAMPAY_UPI_ID=das360s@fam
FAMPAY_UPI_ID=das360s@fam
UPI_ID=das360s@fam

# ---- Bank Credit-Alert Email Verification ----
# Gmail address receiving credit alerts (FamPay, HDFC, SBI, ICICI, Axis, Paytm, etc.)
GMAIL_USER=sundardas963@gmail.com
NEXT_PUBLIC_GMAIL_USER=sundardas963@gmail.com

# OPTION A: 16-character Google App Password (IMAP Mode - Recommended & Fastest)
# Generated at: Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=your_16_digit_app_password

# OPTION B: Gmail REST API OAuth2 (OAuth Mode - Alternative)
# GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_oauth_client_secret
# GMAIL_REFRESH_TOKEN=your_oauth_refresh_token

# ---- Bot License Key API & Board Integration ----
# Provided official board API key
BOARD_API_KEY=mani272_8ca9bcfb6152cbbb5b5d42e4a2637bd074edf134
BOT_API_KEY=mani272_8ca9bcfb6152cbbb5b5d42e4a2637bd074edf134
CRON_SECRET=mani272_8ca9bcfb6152cbbb5b5d42e4a2637bd074edf134

# Optional: External Key Panel / Board API URL if using a remote bot endpoint
# BOARD_API_URL=https://your-panel.com/api/generate-key

# Discord Webhook URL for real-time sales & payment notifications
DISCORD_SALES_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# ---- Database (Dual Mode: SQLite/File ACID Store + Optional MongoDB) ----
# MongoDB connection URI (e.g. MongoDB Atlas). If omitted, system runs on ACID local/temp storage.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mani272store?retryWrites=true&w=majority

# ---- Supabase (Optional) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- App Config ----
NEXT_PUBLIC_APP_NAME=MANI 272 STORE
NEXT_PUBLIC_ADMIN_EMAILS=sundardas963@gmail.com,admin@mani272store.com

# ---- Discord Community ----
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/4DMtsmZX6k
NEXT_PUBLIC_DISCORD_SERVER_NAME=MANI 272 STORE
NEXT_PUBLIC_DISCORD_SERVER_DESCRIPTION=Join our community for support, updates and exclusive offers.

# ---- YouTube Official Channel ----
NEXT_PUBLIC_YOUTUBE_CHANNEL_NAME=EAGLE 272
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@eagle272-v4p

# ---- Site URL ----
